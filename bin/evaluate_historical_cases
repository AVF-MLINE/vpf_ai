#!/usr/bin/env ruby
# frozen_string_literal: true

$LOAD_PATH.unshift(File.expand_path("../lib", __dir__))

require "json"
require "vpf_ai"

abort("usage: bin/evaluate_historical_cases path/to/results.json") unless ARGV[0]

report = VpfAi::HistoricalDatasetEvaluator.new.evaluate_file(ARGV[0])
puts JSON.pretty_generate(report)
